# Server
PORT=4000
NODE_ENV=development

# Supabase Postgres connection (used by backend server side)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DB?sslmode=require

# Supabase project settings
# Use only in backend. Do NOT expose to frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: CORS
CORS_ORIGIN=http://localhost:5173

